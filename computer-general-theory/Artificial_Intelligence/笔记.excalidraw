    {
      "id": "9pmqaO0zDvpWoyw7HK3JT",
      "type": "text",
      "x": 3932.184194921907,
      "y": -446.0916056100548,
      "width": 1700.4443766276038,
      "height": 132.84721692403158,
      "angle": 0,
      "strokeColor": "#1e1e1e",
